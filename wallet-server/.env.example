# Copy to .env (never commit it) or set these in your host's secret settings.

# From https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production
PLAID_ENV=sandbox

# 32 random bytes, base64. Encrypts bank access tokens at rest.
#   openssl rand -base64 32
CASHLINE_ENCRYPTION_KEY=

# Who may use this server: comma-separated userId:token pairs.
# Paste the token into the app (Settings → Bank connections → Access token).
#   openssl rand -hex 32
CASHLINE_API_TOKENS=me:

# Optional
PORT=8787
DATABASE_PATH=./data/cashline.db
# Live balance calls are billed per call; reuse a live result for this long.
REALTIME_MIN_INTERVAL_SECONDS=300
# Needed only for OAuth banks (Chase, etc.) in production: a universal link
# registered in the Plaid dashboard.
PLAID_REDIRECT_URI=
